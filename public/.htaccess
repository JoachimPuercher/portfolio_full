# Static Next.js export on Apache (world4you).
# Everything a Next.js server would do at runtime lives here. Every block is wrapped
# in <IfModule> so a missing module never causes a 500.
#
# Pages are exported as directories with an index.html (/de/imprint/index.html), so
# Apache serves them with its default DirectoryIndex; a request without the trailing
# slash (/de/imprint) is redirected to /de/imprint/ by mod_dir. No rewrite needed.

Options -Indexes
AddDefaultCharset UTF-8

# Unknown paths: Next exports app/not-found.tsx as /404.html (bilingual).
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # "/" -> language version: 1) NEXT_LOCALE cookie (set by the language switch),
  # 2) browser language, 3) German. 302 because the target depends on the visitor.
  RewriteCond %{HTTP_COOKIE} (^|;\s*)NEXT_LOCALE=en(;|$) [NC]
  RewriteRule ^$ /en/ [R=302,L]
  RewriteCond %{HTTP_COOKIE} (^|;\s*)NEXT_LOCALE=de(;|$) [NC]
  RewriteRule ^$ /de/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L]
  RewriteRule ^$ /de/ [R=302,L]

  # URLs of the former Angular site (permanent, keeps links and rankings).
  RewriteRule ^imprint/?$ /de/imprint/ [R=301,L]
  RewriteRule ^data-save/?$ /de/data-save/ [R=301,L]
  RewriteRule ^project-details/?$ /de/projects/join/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"

  # Build assets carry a content hash in their name: cache them for a year.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # HTML must always be revalidated so a new upload is visible immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
