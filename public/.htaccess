# Static Next.js export on Apache (world4you).
# Everything a Next.js server would do at runtime lives here. Every block is wrapped
# in <IfModule> so a missing module never causes a 500, and only directives that
# world4you permits in .htaccess are used: no "Options" (rejected there, would take
# the whole site down with a 500) and no mod_expires (needs AllowOverride Indexes).
#
# Pages are exported as directories with an index.html (/de/imprint/index.html), so
# Apache serves them with its DirectoryIndex; a request without the trailing slash
# (/de/imprint) is redirected to /de/imprint/ by mod_dir. No rewrite needed for pages.

AddDefaultCharset UTF-8

# Unknown paths: Next exports app/not-found.tsx as /404.html (bilingual).
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # "/" -> language version: 1) NEXT_LOCALE cookie (set by the language switch),
  # 2) browser language, 3) German. 302 because the target depends on the visitor.
  RewriteCond %{HTTP_COOKIE} (^|;\s*)NEXT_LOCALE=en(;|$) [NC]
  RewriteRule ^$ /en/ [R=302,L]
  RewriteCond %{HTTP_COOKIE} (^|;\s*)NEXT_LOCALE=de(;|$) [NC]
  RewriteRule ^$ /de/ [R=302,L]
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L]
  RewriteRule ^$ /de/ [R=302,L]

  # URLs of the former Angular site (permanent, keeps links and rankings).
  RewriteRule ^imprint/?$ /de/imprint/ [R=301,L]
  RewriteRule ^data-save/?$ /de/data-save/ [R=301,L]
  RewriteRule ^project-details/?$ /de/projects/join/ [R=301,L]

  # Directories without an index.html (/de/projects/, /images/, /_next/static/chunks/):
  # never list them, answer with the 404 page instead ("Options -Indexes" replacement).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"

  # HTML and the client router's .txt payloads must always be revalidated, so a new
  # upload is visible immediately (also for client-side navigation).
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images and the favicon: 30 days.
  <FilesMatch "\.(png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Build assets carry a content hash in their name: cache them for a year.
  # (<If> is merged last, so it wins over the FilesMatch rules above.)
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>
