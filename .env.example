# Public base URL (canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.puercherjoachim.com

# Server-side target of the contact form forwarder (app/api/contact/route.ts).
# Currently the existing PHP mailer of the Angular site. If the domain moves to
# Vercel, host sendMail.php under another hostname and point this there.
CONTACT_FORWARD_URL=https://www.puercherjoachim.com/sendMail.php
